# Adres projektu Supabase (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Klucz service_role (Settings → API → service_role secret).
# NIE dodawaj prefiksu NEXT_PUBLIC_ — ten klucz pomija RLS i nie może
# trafić do przeglądarki. Używany wyłącznie w Server Action po stronie serwera.
SUPABASE_SERVICE_ROLE_KEY=

# Stałe konto testowe Fazy 1 — auth.users.id, do którego przypięta jest
# firma w tabeli `firmy`. Docelowo zastąpi je zalogowany użytkownik.
ATUTO_TEST_USER_ID=

# Klucz API Resend (resend.com → API Keys). Wyłącznie po stronie serwera.
RESEND_API_KEY=

# Adres nadawcy skierowań. Resend pozwala wysyłać tylko z domeny
# zweryfikowanej w panelu; do czasu weryfikacji atuto.pl działa
# onboarding@resend.dev, ale wtedy odbiorcą może być wyłącznie adres
# właściciela konta Resend. Po weryfikacji domeny wystarczy podmienić
# tę wartość — kod się nie zmienia.
RESEND_FROM=onboarding@resend.dev

# Ścieżka do lokalnej przeglądarki dla generowania PDF.
# Na Vercelu ZOSTAW PUSTE — tam używana jest binarka @sparticuz/chromium.
# Lokalnie bez tego PDF się nie wygeneruje (binarka sparticuz jest
# skompilowana pod Amazon Linux). Przykład dla Windows:
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
PUPPETEER_EXECUTABLE_PATH=
