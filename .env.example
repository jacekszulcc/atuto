# Adres projektu Supabase (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Klucz service_role (Settings → API → service_role secret).
# NIE dodawaj prefiksu NEXT_PUBLIC_ — ten klucz pomija RLS i nie może
# trafić do przeglądarki. Używany wyłącznie w Server Action po stronie serwera.
SUPABASE_SERVICE_ROLE_KEY=

# Stałe konto testowe Fazy 1 — auth.users.id, do którego przypięta jest
# firma w tabeli `firmy`. Docelowo zastąpi je zalogowany użytkownik.
ATUTO_TEST_USER_ID=
